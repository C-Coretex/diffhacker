<Project>

  <!-- Inherit the repository defaults, then add what every test project needs. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!--
      xUnit v3 runs on Microsoft.Testing.Platform, where each test project is a self-executing
      program rather than a library loaded by a runner. The .NET 10 SDK dropped the VSTest
      bridge, so global.json also selects the Microsoft.Testing.Platform runner.
    -->
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <UseVSTest>false</UseVSTest>
    <!--
      Generated contract types and test fixtures trip analyzers that are worth enforcing in
      product code but only add noise here.
    -->
    <NoWarn>$(NoWarn);CA1707;CA1861;CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      xunit.v3 test projects are self-executing under Microsoft.Testing.Platform, so
      Microsoft.NET.Test.Sdk (the VSTest host) is deliberately absent. xunit.runner.visualstudio
      is kept so the projects also show up in the Visual Studio Test Explorer.
    -->
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

</Project>
