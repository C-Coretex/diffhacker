<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The headless toolbox: the same tools DiffHacker uses internally, served over stdio to any MCP
    client.

    A separate executable rather than a mode of DiffHacker.Host, decided during Iteration 5
    planning. The host becomes a windowed application in Iteration 14, and a windowed subsystem
    has no usable stdout — which is the entire transport here. Keeping them apart also means an
    external agent running this never loads PhotinoX or a native WebView.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>DiffHacker.Mcp</RootNamespace>
    <AssemblyName>diffhacker-mcp</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DiffHacker.Core\DiffHacker.Core.csproj" />
    <ProjectReference Include="..\DiffHacker.Git\DiffHacker.Git.csproj" />
    <ProjectReference Include="..\DiffHacker.Tools\DiffHacker.Tools.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.Core" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

</Project>
