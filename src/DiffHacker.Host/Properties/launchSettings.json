{
  "profiles": {
    "DiffHacker": {
      "commandName": "Project",
      "workingDirectory": "$(ProjectDir)"
    },
    "DiffHacker (verbose logging)": {
      "commandName": "Project",
      "commandLineArgs": "--verbose",
      "workingDirectory": "$(ProjectDir)"
    },
    "DiffHacker (throwaway state)": {
      "commandName": "Project",
      "commandLineArgs": "--data-dir $(TEMP)\\diffhacker-scratch --verbose",
      "workingDirectory": "$(ProjectDir)"
    }
  }
}
